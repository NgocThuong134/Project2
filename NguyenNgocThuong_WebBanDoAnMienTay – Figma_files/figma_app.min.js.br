:root {
  --expandAnimationTime: 100ms;
}
.avatar_elements--avatarContainer---Bu06 {
  display: flex;
  min-width: 26px;
  visibility: visible;
}
/* Left position is set in javascript */
.avatar_elements--avatar--g70D- {
  width: 24px;
  height: 24px;
  border-radius: 100%;
  border: 1px solid var(--color-bg, #ffffff);
  /* stylelint-disable @figma/color-no-raw -- TODO: refactor with semantic token */
  background: linear-gradient(
      136.68deg,
      rgba(0, 0, 0, 0.05) 11.37%,
      rgba(255, 255, 255, 0.039) 82.26%
    ),
    #f0f0f0;
  /* stylelint-enable @figma/color-no-raw */
}
.avatar_elements--inCluster--hjnYx .avatar_elements--avatar--g70D-,
.avatar_elements--inCluster--hjnYx .avatar_elements--fallbackAvatar--dYw7b,
.avatar_elements--inCluster--hjnYx .avatar_elements--avatarOverflowCounter--Etvgh {
  border-width: 2px;
}
.avatar_elements--fallbackAvatar--dYw7b {
  width: 24px;
  height: 24px;
  border-radius: 100%;
  /* TODO(dark mode): avatar text color */
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 13px;
  text-transform: uppercase;
  border: 1px solid var(--color-bg, #ffffff);
}
/* Avatar elements */
.avatar_elements--avatarsRoot--xkNOD {
  display: flex;
  transition: opacity var(--expandAnimationTime) ease-in-out,
    visibility var(--expandAnimationTime) ease-in-out;
}
.avatar_elements--avatarsContainer--e5AeW {
  display: flex;
  flex-direction: row-reverse;
  justify-content: flex-end;
  align-items: flex-start;
  min-width: 26px;
  min-height: 26px;
}
.avatar_elements--avatarsPrimaryContainer--EYqE5 {
  display: flex;
  flex-direction: row-reverse;
}
.avatar_elements--avatarsPrimaryContainer--EYqE5 > * {
  margin-left: -6px;
  margin-right: 0px;
  transition: margin-left var(--expandAnimationTime) ease-in-out;
  -webkit-transition: margin-left var(--expandAnimationTime) ease-in-out;
  /* We add a z-index to force the stacking context to stack elements further down the DOM
     above elements further up the DOM */
  z-index: 0;
}
.avatar_elements--avatarsPrimaryContainer--EYqE5 > *:last-child {
  margin-left: 0;
}
.avatar_elements--avatarsOverflowContainer--1GrP7 {
  display: flex;
  flex-direction: row-reverse;
  margin-left: -6px;
  transition: margin-left var(--expandAnimationTime) ease-in-out;
  -webkit-transition: margin-left var(--expandAnimationTime) ease-in-out;
  min-width: 4px;
  /* The overflow container should always be above the secondary container when they overlap */
  /* We add a z-index to force the stacking context to stack elements further down the DOM
     above elements further up the DOM */

  z-index: 0;
}
.avatar_elements--avatarsSecondaryContainer--JzxPl {
  display: flex;
  flex-direction: row-reverse;
  margin-left: -26px;
  max-width: 26px;
  overflow: hidden;
  border-radius: 16px 0 0 16px;
  transition: max-width var(--expandAnimationTime) ease-in-out;
  -webkit-transition: max-width var(--expandAnimationTime) ease-in-out;
}
.avatar_elements--avatarsSecondaryContainer--JzxPl > * {
  margin-left: 5px;
}
.avatar_elements--avatarsSecondaryContainer--JzxPl > *:last-child {
  margin-left: 33px !important;
}
.avatar_elements--avatarsOverflowAvatar---tKDK {
  margin-left: -26px;
}
@property --num {
  syntax: '<integer>';
  initial-value: 0;
  inherits: false;
}
.avatar_elements--avatarOverflowCounter--Etvgh {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 24px;
  width: 24px;
  border-radius: 50%;
  /* TODO(dark mode): --color-text against --color-bg-secondary */
  background-color: var(--color-bg-secondary, #b2b2b2);
  border: 1px solid var(--color-bg, white);
  color: var(--color-text, white);
  font-size: 13px;
  text-transform: uppercase;
  font-family: 'Inter', sans-serif;

  transition: --num var(--expandAnimationTime);
  -webkit-transition: --num var(--expandAnimationTime);
  counter-reset: num var(--num);
  --num: var(--overflowCount);
  opacity: var(--num);
  /* The overflow counter should always be on top any avatar placed in the overflow container */
  /* We add a z-index to force the stacking context to stack elements further down the DOM
     above elements further up the DOM */

  z-index: 0;
}
.avatar_elements--unread--aO1FQ .avatar_elements--avatarOverflowCounter--Etvgh {
  background-color: var(--color-bg-brand-secondary, #1167b0);
  border-color: var(--color-bg-brand, #0d99ff);
  color: var(--color-text-onbrand, white);
}
.avatar_elements--avatarOverflowCounter--Etvgh::after {
  content: counter(num);
}
.avatar_elements--avatarPinAnchor--V--rN {
  --scale: 1;
  position: absolute;
  will-change: transform;
  /* transform property set programatically in avatar_pin_element_display.tsx */
  transform-origin: bottom left;
  -moz-user-select: none;
   -ms-user-select: none;
       user-select: none;
  -webkit-user-select: none;
}
.avatar_elements--feedPinAnchor--x1V80 {
