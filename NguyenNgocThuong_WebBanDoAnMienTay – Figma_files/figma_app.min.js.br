:root {
  --scale: 1;
}
.avatar_cluster_element_updatable--avatarClusterAnchor--1rSn8 {
  position: absolute;
  will-change: transform;
  /* transform property set programatically in avatar_cluster_element.tsx */
  -moz-user-select: none;
   -ms-user-select: none;
       user-select: none;
  -webkit-user-select: none;
}
.avatar_cluster_element_updatable--avatarCluster--5P77- {
  display: flex;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  font-size: 13px;
}
/* We are using a before pseudo element here because
 * We want to scale the cluster size on hover but not its
 * child elements.
 */
.avatar_cluster_element_updatable--avatarCluster--5P77-:before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;

  background: var(--color-bg, #ffffff);
  border-radius: 50%;
  box-shadow: var(
    --elevation-200-canvas,
    0px 3px 6px rgba(0, 0, 0, 0.3),
    0 0 1px rgba(0, 0, 0, 0.05)
  );
  transition: transform 250ms cubic-bezier(0.4, 0, 0, 1);
}
.avatar_cluster_element_updatable--avatarCluster--5P77-:hover::before {
  transform: scale(1.1);
}
.avatar_cluster_element_updatable--unread--u8SLa .avatar_cluster_element_updatable--avatarCluster--5P77-::before {
  background: var(--color-bg-brand, #0d99ff);
  box-shadow: var(
    --elevation-200-canvas,
    0px 1px 2px rgba(0, 0, 0, 0.1),
    0px 5px 8px rgba(0, 0, 0, 0.3)
  );
  color: #ffffff; /* stylelint-disable-line @figma/color-no-raw -- TODO: refactor with semantic token */
}
.avatar_cluster_element_updatable--avatarCluster--5P77-:hover > .avatar_cluster_element_updatable--avatar--HCltC {
  transform: scale(0.2);
  opacity: 0 !important;
  transition: all 200ms ease-in-out;
}
.avatar_cluster_element_updatable--avatarCluster--5P77-:hover:after {
  opacity: 1;
}
.avatar_cluster_element_updatable--unread--u8SLa .avatar_cluster_element_updatable--avatarCluster--5P77-:after {
  background-color: var(--color-bg-brand, rgba(13, 153, 255, 1));
  color: var(--color-text-onbrand, rgb(255, 255, 255));
}
.avatar_cluster_element_updatable--dimmed--CNUgO .avatar_cluster_element_updatable--avatarCluster--5P77- {
  opacity: 0.5;
}
.avatar_cluster_element_updatable--dimmed--CNUgO:hover .avatar_cluster_element_updatable--avatarCluster--5P77- {
  opacity: 1;
}
.avatar_cluster_element_updatable--emphasized--Ul6Ni .avatar_cluster_element_updatable--avatarCluster--5P77-::before {
  transform: scale(1.2);
}
.avatar_cluster_element_updatable--clusterCount--TSPTd {
  display: block;
  position: absolute;
  height: 100%;
  width: 100%;
  opacity: 0;
  border-radius: 50%;
  background-color: var(--color-bg, #ffffff);
  overflow: hidden;
  transition: opacity 250ms cubic-bezier(0.4, 0, 0, 1);
  font-weight: 600;
}
.avatar_cluster_element_updatable--clusterCount--TSPTd::after {
  display: inline-block;
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  vertical-align: -50%;
  text-align: center;
