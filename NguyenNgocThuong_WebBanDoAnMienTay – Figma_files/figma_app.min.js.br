  transform: translateY(-50%);
  border-radius: 50%;
}
.avatar_cluster_element_updatable--unread--u8SLa .avatar_cluster_element_updatable--clusterCount--TSPTd {
  background-color: var(--color-bg-brand, #0d99ff);
  color: var(--color-text-onbrand, white);
