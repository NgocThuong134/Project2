  .multiplayer-animation-svg {
    position: absolute;
    top: 0px;
    left: 0px;
    width: ${pK}px;
  }

  .multiplayer-animation-svg.horizontal {
    padding-left: 8px;
  }

  .multiplayer-animation-droplet {
    left: ${pK/2-7}px;
    top: 0px;
    height: 2px;
    width: 14px;
    border-radius: 0px;
    position: absolute;
  }

  .multiplayer-animation-droplet-horizontal {
    left: 0px;
    top: ${pK/2+.5}px;
    height: 14px;
    width: 2px;
    border-radius: 0px;
    position: absolute;
  }

  .multiplayer-animation-droplet.selected {
    animation: droplet 0.3s ease-in forwards;
  }

  .multiplayer-animation-droplet-horizontal.selected {
    animation: droplet-horizontal 0.3s ease-in forwards;
  }

  .multiplayer-animation-droplet.deselected {
    animation: droplet-reverse 0.2s ease-out 0.4s forwards;
    left: ${pK/2-3.5}px;
    top: 0px;
    height: 0px;
    width: 0px;
    border-radius: 0px;
  }

  .multiplayer-animation-droplet-horizontal.deselected {
    animation: droplet-horizontal-reverse 0.2s ease-out 0.4s forwards;
    left: ${pK/2-3.5}px;
    height: 0px;
    width: 0px;
    border-radius: 0px;
  }

  .multiplayer-animation-circle {
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    transform-origin: center;
    transform: rotateZ(-90deg);
  }

  .multiplayer-animation-circle.horizontal {
    transform: rotateZ(-180deg);
  }

  .multiplayer-animation-circle.selected {
    animation: draw-circle 0.15s ease-in 0.3s forwards;
  }

  .multiplayer-animation-circle-horizontal.selected {
    animation: draw-circle-horizontal 0.15s ease-in 0.3s forwards;
  }

  .multiplayer-animation-circle.deselected {
    animation: draw-circle-reverse 0.4s ease-in forwards;
  }

  .multiplayer-animation-circle.presenting {
    stroke-dasharray: 3;
    animation: rotating 30s linear infinite
  }

  @keyframes rotating {
    from {
      transform: rotateZ(0deg);
    }
    to {
      transform: rotateZ(360deg);
    }
  }

  @keyframes droplet {
    0% {
      left: ${pK/2-7}px;
      top: 0px;
      height: 2px;
      width: 14px;
      border-radius: 0px;
    }
    20% {
      left: ${pK/2-3.5}px;
      top: -3.5px;
      height: 7px;
      width: 7px;
      border-radius: 100%;
    }
    66% {
      top: -2px;
      height: 7px;
    }
    98% {
      top: 5px;
      left: ${pK/2-1.5}px;
      height: 3px;
      width: 3px;
      border-radius: 100%;
    }
    99% {
      top: 5px;
      left: ${pK/2-.5}px;
      height: 1px;
      width: 1px;
      border-radius: 100%;
    }
    100% {
      top: 5px;
      left: ${pK/2-.5}px;
      height: 0px;
      width: 0px;
      border-radius: 100%;
    }
  }

  @keyframes droplet-horizontal {
    0% {
      left: 0;
      top: ${pK/2+.5}px;
      height: 14px;
      width: 2px;
      border-radius: 0px;
    }
    20% {
      top: ${pK/2+3.5}px;
      left: -3.5px;
      height: 7px;
      width: 7px;
      border-radius: 100%;
    }
    66% {
      left: -2px;
      width: 7px;
    }
    99% {
      left: 5px;
      top: ${pK/2+5.5}px;
      height: 3px;
      width: 3px;
      border-radius: 100%;
    }
    100% {
      left: 5px;
      top: ${pK/2+6.5}px;
      height: 0px;
      width: 0px;
      border-radius: 100%;
    }
  }

  @keyframes draw-circle {
    0% {
      stroke-dashoffset: 400;
    }
    100% {
      stroke-dashoffset: 300;
    }
  }

  @keyframes droplet-reverse {
    0% {
      left: ${pK/2-3.5}px;
      top: 0px;
      height: 2px;
      width: 2px;
      border-radius: 0px;
    }
    100% {
      left: ${pK/2-7}px;
      top: 0px;
      height: 2px;
      width: 14px;
      border-radius: 0px;
    }
  }

  @keyframes droplet-horizontal-reverse {
    0% {
      left: 0px;
      height: 2px;
      width: 2px;
      border-radius: 0px;
    }
    100% {
      left: 0px;
      width: 2px;
      height: 14px;
      border-radius: 0px;
