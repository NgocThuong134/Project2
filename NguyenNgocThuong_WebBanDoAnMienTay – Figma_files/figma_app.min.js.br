.variable_pill_base--pillBase---YQPm {
  align-items: center;
  border-radius: 4px;
  border-width: 1px;
  border-style: solid;
  box-sizing: border-box;
  height: 20px;
  overflow: hidden;
  padding: 0 5px;
  display: inline
}

.variable_pill_base--pillBase---YQPm.variable_pill_base--pillHasIcon--1ULGY {
    padding: 0 5px 0 3px;
  }

.variable_pill_base--pillBase---YQPm.variable_pill_base--pillDefault--QvWDD {
    color: var(--color-text);
    background-color: var(--color-bg-secondary);
    border-color: var(--color-border)
  }

.variable_pill_base--pillBase---YQPm.variable_pill_base--pillDefault--QvWDD:not(.variable_pill_base--pillDisableHover--VG-5z):hover {
      background-color: var(--color-bg-tertiary);
      border-color: var(--color-bg-tertiary);
    }

.variable_pill_base--pillBase---YQPm.variable_pill_base--pillDisabled--28DcY {
    color: var(--color-text-disabled);
    background-color: var(--color-bg-secondary);
    border-color: var(--color-border)
  }

.variable_pill_base--pillBase---YQPm.variable_pill_base--pillDisabled--28DcY:not(.variable_pill_base--pillDisableHover--VG-5z):hover {
      background-color: var(--color-bg);
      border-color: var(--color-border);
    }

.variable_pill_base--pillBase---YQPm.variable_pill_base--pillDisabledTertiary--KnYjB {
    color: var(--color-text-tertiary);
    background-color: var(--color-bg);
    border-color: var(--color-border);
  }

.variable_pill_base--pillBase---YQPm.variable_pill_base--pillSelected--Nzecb {
    color: var(--color-text);
    background-color: var(--color-bg-selected);
    border-color: var(--color-border-selected);
  }

.variable_pill_base--pillBase---YQPm.variable_pill_base--pillInSelection--ZEkHo {
    color: var(--color-text);
    background-color: var(--color-bg-onselected);
    border-color: var(--color-border-onselected);
  }

.variable_pill_base--pillBase---YQPm.variable_pill_base--pillNarrow--dmTS- {
    padding: 0 2px;
  }
