@media (pointer: coarse) {
  .avatar_elements--avatarPinAnchor--V--rN {
    --scale: 1.15;
  }
}
.avatar_elements--avatarPinContainer--28ySv {
  display: flex;
  position: absolute;
  left: 0px;
  bottom: 0px;
  min-width: 26px;
  align-self: flex-start;
  justify-self: flex-start;
  flex-direction: row;
  max-width: 240px;
  box-sizing: border-box;
  padding: 3px 3px;
  font-size: 11px;
  line-height: 16px;
  color: var(--color-text, #333333);
  background-color: var(--color-bg, white);
